# The FastAPI service. Server-side only — never exposed to the browser.
FASTAPI_URL=http://127.0.0.1:8001

# ── Authentication (SSO — Microsoft Entra ID, certificate-authenticated) ────
# All five are required for sign-in to work. With any one missing, every
# visitor sees a "sign-in is not configured" screen instead of a working
# Microsoft button — see web/README.md's "Authentication (SSO)" section for
# how to register the app in Entra and fill these in.
#
# Certificate, not a client secret: next-auth's own Microsoft Entra ID
# provider cannot produce the client assertion Entra requires for
# certificate auth (see lib/msal.ts), so sign-in is wired through
# @azure/msal-node directly (app/api/auth/entra/*) instead of that provider.

# A long random string NextAuth uses to sign/encrypt the session cookie,
# and this app reuses to sign its own short-lived sign-in-flow cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# From the Entra app registration ("App registrations" -> your app -> Overview).
AUTH_MICROSOFT_ENTRA_ID_ID=
# Also from the Overview page — this is what restricts sign-in to AGL's
# own tenant (see auth.ts's doc comment).
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# The certificate registered under "Certificates & secrets" -> Certificates
# for this app. Extract both from the .pfx your PKI/IT process issued:
#
#   openssl pkcs12 -in cert.pfx -nocerts -nodes -out key.pem
#   sed -n '/-----BEGIN PRIVATE KEY-----/,/-----END PRIVATE KEY-----/p' key.pem
#   openssl pkcs12 -in cert.pfx -clcerts -nokeys -out cert.pem
#   openssl x509 -in cert.pem -noout -fingerprint -sha256   # strip the colons
#
# Hex, no colons (e.g. AB12CD34EF56AB12CD34EF56AB12CD34EF56AB12CD34EF56AB12CD34EF56AB).
AUTH_MICROSOFT_ENTRA_ID_CERT_THUMBPRINT=
# The PEM private key on one line, with real newlines replaced by "\n"
# (lib/msal.ts unescapes it when reading). Keep the full
# "-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----" block.
AUTH_MICROSOFT_ENTRA_ID_CERT_PRIVATE_KEY=

# Only needed when NOT deployed on Vercel (Vercel sets this for you). Tells
# NextAuth to trust the Host header of the platform it's running behind
# (Azure Container Apps, Docker, etc.) rather than refusing the request.
# AUTH_TRUST_HOST=true
