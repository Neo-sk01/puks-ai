  "join_logic": {
    "expected_header_to_lines": {
      "tables": [
        "AEN_DAT",
        "REA_DAT"
      ],
      "description": "Get expected receipt with all its expected lines",
      "join_conditions": [
        "AEN.ACT_CODE = REA.ACT_CODE",
        "AEN.REA_CTAF = REA.REA_CTAF",
        "AEN.REA_RFCE = REA.REA_RFCE"
      ],
      "example_sql": "SELECT aen.REA_RFCE, rea.ART_CODE, rea.REA_NORL FROM AEN_DAT aen INNER JOIN REA_DAT rea ON aen.ACT_CODE = rea.ACT_CODE AND aen.REA_CTAF = rea.REA_CTAF AND aen.REA_RFCE = rea.REA_RFCE WHERE aen.ACT_CODE = :ACT_CODE"
    },
    "expected_to_reception_header": {
      "tables": [
        "REA_DAT",
        "REE_DAT"
      ],
      "description": "Link expected receipt to the actual reception that fulfilled it",
      "join_conditions": [
        "REA.ACT_CODE = REE.ACT_CODE",
        "REA.REA_CTAF = REE.TIE_CODE",
        "REA.REA_BL = REE.REE_NOFO"
      ],
      "note": "TIE_CODE exception: in REA_DAT the supplier code is stored as REA_CTAF — not TIE_CODE"
    },
    "reception_header_to_lines": {
      "tables": [
        "REE_DAT",
        "REL_DAT"
      ],
      "description": "Get reception header with all its received lines",
      "join_conditions": [
        "REL.ACT_CODE = REE.ACT_CODE",
        "REL.REE_NORE = REE.REE_NORE"
      ],
      "example_sql": "SELECT ree.REE_NORE, ree.TIE_CODE, ree.REE_DARE, rel.ART_CODE, rel.REL_NORL FROM REE_DAT ree INNER JOIN REL_DAT rel ON rel.ACT_CODE = ree.ACT_CODE AND rel.REE_NORE = ree.REE_NORE WHERE ree.ACT_CODE = :ACT_CODE AND ree.REE_NORE = :REE_NORE"
    },
    "reception_line_to_stock": {
      "tables": [
        "REL_DAT",
        "STK_DAT"
      ],
      "description": "Find the stock record created from a reception line",
      "join_conditions": [
        "REL.ACT_CODE = STK.ACT_CODE",
        "REL.REE_NORE = STK.STK_NORE",
        "REL.REL_NORL = STK.STK_NOREL"
      ],
      "example_sql": "SELECT rel.REE_NORE, rel.ART_CODE, stk.STK_KEYU, stk.EMP_LIEU FROM REL_DAT rel INNER JOIN STK_DAT stk ON rel.ACT_CODE = stk.ACT_CODE AND rel.REE_NORE = stk.STK_NORE AND rel.REL_NORL = stk.STK_NOREL WHERE rel.ACT_CODE = :ACT_CODE"
    },
    "reception_line_to_movement": {
      "tables": [
        "REL_DAT",
        "MVT_DAT"
      ],
      "description": "Find stock entry movements for a reception line",
      "join_conditions": [
        "REL.ACT_CODE = MVT.ACT_CODE",
        "REL.REE_NORE = MVT.STK_NORE",
        "REL.REL_NORL = MVT.REL_NORE",
        "REL.ART_CODE = MVT.ART_CODE",
        "MVT.TMV_CODE = '10010'"
      ],
      "note": "TMV_CODE = 10010 filters for stock entry creation movements only"
    },
    "movement_to_stock": {
      "tables": [
        "MVT_DAT",
        "STK_DAT"
      ],
      "description": "Link any movement back to its stock record",
      "join_conditions": [
        "MVT.STK_KEYU = STK.STK_KEYU"
      ],
      "example_sql": "SELECT mvt.TMV_CODE, mvt.ACT_CODE, stk.ART_CODE, stk.EMP_LIEU FROM MVT_DAT mvt INNER JOIN STK_DAT stk ON mvt.STK_KEYU = stk.STK_KEYU WHERE mvt.ACT_CODE = :ACT_CODE"
    },
    "full_inbound_trace": {
      "tables": [
        "REE_DAT",
        "REL_DAT",
        "STK_DAT",
        "ART_PAR"
      ],
      "description": "Full inbound trace from reception header to stock with article details",
      "join_conditions": [
        "REL.ACT_CODE = REE.ACT_CODE",
        "REL.REE_NORE = REE.REE_NORE",
        "REL.ACT_CODE = STK.ACT_CODE",
        "REL.REE_NORE = STK.STK_NORE",
        "REL.REL_NORL = STK.STK_NOREL",
        "ART.ACT_CODE = REL.ACT_CODE",
        "ART.ART_CODE = REL.ART_CODE"
      ],
      "example_sql": "SELECT ree.REE_NORE, ree.REE_DARE, ree.TIE_CODE, rel.ART_CODE, art.ART_DESL, stk.EMP_LIEU, stk.STK_KEYU FROM REE_DAT ree INNER JOIN REL_DAT rel ON rel.ACT_CODE = ree.ACT_CODE AND rel.REE_NORE = ree.REE_NORE INNER JOIN STK_DAT stk ON rel.ACT_CODE = stk.ACT_CODE AND rel.REE_NORE = stk.STK_NORE AND rel.REL_NORL = stk.STK_NOREL INNER JOIN ART_PAR art ON art.ACT_CODE = rel.ACT_CODE AND art.ART_CODE = rel.ART_CODE WHERE ree.ACT_CODE = :ACT_CODE AND ree.REE_NORE = :REE_NORE"
    }
  },
  "procedures": [
    {
      "procedure_name": "Get Reception with Status Filter",
      "category": "Inbound",
      "access_level": "Support",
      "query": {
        "sql": "SELECT ree.REE_NORE, ree.TIE_CODE, ree.REE_DARE, ree.REE_ETRE FROM REE_DAT ree WHERE ree.ACT_CODE = :ACT_CODE AND ree.REE_ETRE = :STATUS_CODE;"
      },
      "business_logic": "Retrieve all receptions filtered by status code. Use reference_codes.reception_status for valid values."
    },
    {
      "procedure_name": "Get All Lines for a Reception",
      "category": "Inbound",
      "access_level": "Support",
      "query": {
        "sql": "SELECT rel.REE_NORE, rel.REL_NORL, rel.ART_CODE, rel.REL_NOSU FROM REL_DAT rel WHERE rel.ACT_CODE = :ACT_CODE AND rel.REE_NORE = :REE_NORE ORDER BY rel.REL_NORL;"
      },
      "business_logic": "Retrieve all reception lines for a given reception number."
    }
  ],
  "reference_codes": {
    "reception_type": {
      "field": "REA_TYAT (on REA_DAT) or TRC_CODE (on REE_DAT)",
      "values": {
        "001": "Réception — standard inbound receipt",
        "100": "Retour — customer/internal return"
      }
    },
    "reception_status": {
      "field": "REE_ETRE on REE_DAT",
      "values": {
        "001": "En Cours — reception in progress",
        "100": "Rangée — goods put away to stock locations",
        "200": "Clôturée — reception fully closed"
      }
    },
    "movement_type_inbound": {
      "field": "TMV_CODE on MVT_DAT",
      "values": {
        "10010": "Stock entry creation from reception — use this to filter inbound movements"
      }
    }
  },
  "safety_rules": [
    "Always filter by ACT_CODE on every table access",
    "Do NOT join REL_DAT directly to REA_DAT unless the expected receipt has exactly 1 reception line — use MVT_DAT as the bridge instead",
    "Stock creation movement TMV_CODE = 10010 must be used to correctly identify inbound stock movements",
    "REA_CTAF in REA_DAT is the equivalent of TIE_CODE — this is a named exception to the standard field naming rule",
    "Always execute SELECT before any UPDATE or DELETE operations",
    "Do not execute UPDATE in production without approval"
  ],
  "_meta": {
