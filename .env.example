# Puks AI — local development. On App Service these are application settings.
# Copy to .env (or .env.local, which overrides .env) and fill in. Both are
# gitignored. Variables already in the environment always win.
#
# ── Provider ───────────────────────────────────────────────────────────────
# azure  (default) one Azure Foundry resource — what production runs on.
# openai           public OpenAI + public Cohere — for local development when
#                  you have no Foundry access. Same models, so an index built
#                  on either provider serves both.
# Unset, "openai" is chosen only when OPENAI_API_KEY is set and AZURE_AI_KEY
# is not; set it explicitly to be sure.
PUKS_PROVIDER=azure
# Per-role overrides. AGL's Foundry resource deploys gpt-5 only, so today:
# generation in the tenant, embeddings on OpenAI, rerank on public Cohere
# (rerank falls back to Cohere on its own when AZURE_RERANK_ENDPOINT is unset
# and COHERE_API_KEY is present; pin it with PUKS_RERANK_PROVIDER).
# PUKS_CHAT_PROVIDER=azure
# PUKS_EMBED_PROVIDER=openai
# PUKS_RERANK_PROVIDER=openai

# ── openai provider ────────────────────────────────────────────────────────
OPENAI_API_KEY=
COHERE_API_KEY=
# Optional overrides (defaults shown).
# OPENAI_CHAT_MODEL=gpt-5
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_EMBED_DIMENSIONS=3072
# COHERE_RERANK_ENDPOINT=https://api.cohere.com/v2/rerank
# COHERE_RERANK_MODEL=rerank-v3.5

# ── azure provider ─────────────────────────────────────────────────────────
#   AZURE_AI_KEY=$(az cognitiveservices account keys list \
#     -g <resource-group> -n <foundry-resource> --query key1 -o tsv)
# The names the Foundry portal hands out are accepted as aliases, so a
# pasted file works unrenamed: FOUNDRY_API_ENDPOINT → AZURE_AI_ENDPOINT,
# FOUNDRY_API_KEY → AZURE_AI_KEY, COHERE_API_KEY_FOUNDRY → AZURE_RERANK_KEY.
# AZURE_RERANK_ENDPOINT is derived from the endpoint when unset.

AZURE_AI_KEY=
AZURE_AI_ENDPOINT=https://<foundry-resource>.openai.azure.com/
AZURE_AI_API_VERSION=2025-04-01-preview

AZURE_CHAT_DEPLOYMENT=gpt-5
AZURE_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_EMBED_DIMENSIONS=3072

# Cohere rerank does NOT use the chat/embeddings inference route. With
# Cohere-rerank-v4.0-pro deployed on the Foundry resource, the working route
# (verified 2026-08-25 against aift003) is the model-inference v1 rerank
# path below — note the api-version query string is part of the URL. The
# resource key authenticates it (Bearer); AZURE_RERANK_KEY is only needed if
# the deployment issues its own.
AZURE_RERANK_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/models/v1/rerank?api-version=2024-05-01-preview
AZURE_RERANK_MODEL=Cohere-rerank-v4.0-pro
# Only set if the rerank deployment issues its own key; defaults to AZURE_AI_KEY.
AZURE_RERANK_KEY=

# gpt-5 is a reasoning model: low keeps latency sane for support answers.
PUKS_REASONING_EFFORT=low
PUKS_VERBOSITY=medium
PUKS_MAX_OUTPUT_TOKENS=4096

# Rerank relevance gate. Defaults follow the reranker in use, measured on
# the 65-question acceptance set (docs/acceptance-results.json):
#   Foundry Cohere-rerank-v4.0-pro → 0.75   (answerable ≥ 0.84, off-topic ≤ 0.70)
#   public  rerank-v3.5            → 0.30   (answerable ≥ 0.35, off-topic ≤ 0.18)
# Set only to override.
# PUKS_CONFIDENCE_THRESHOLD=0.75

# Where the acceptance page stores testers' verdicts (SQLite). Default shown.
# PUKS_ACCEPTANCE_DB=var/acceptance.db
